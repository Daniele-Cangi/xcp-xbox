{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcompute-probe.local/schemas/xcp-creative-adaptation-readiness-v2.schema.json",
  "title": "XCP source-faithful adaptation readiness report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "identities",
    "validation",
    "adaptation_gate",
    "fidelity",
    "corrections",
    "c5_lifecycle",
    "differences",
    "residual_work",
    "worker_gap",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "xcp-creative-adaptation-readiness-v2"
    },
    "report_id": {
      "$ref": "#/$defs/identifier"
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_inventory_sha256",
        "semantic_inventory_sha256",
        "creative_ir_sha256",
        "adaptation_plan_sha256",
        "fidelity_contract_sha256",
        "xcp_project_sha256",
        "source_map_sha256",
        "host_profile_sha256"
      ],
      "properties": {
        "source_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "semantic_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "creative_ir_sha256": { "$ref": "#/$defs/sha256" },
        "adaptation_plan_sha256": { "$ref": "#/$defs/sha256" },
        "fidelity_contract_sha256": { "$ref": "#/$defs/sha256" },
        "xcp_project_sha256": { "$ref": "#/$defs/sha256_or_empty" },
        "source_map_sha256": { "$ref": "#/$defs/sha256_or_empty" },
        "host_profile_sha256": { "$ref": "#/$defs/sha256" },
        "fidelity_evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory",
        "semantic_inventory",
        "creative_ir",
        "adaptation_plan",
        "fidelity_contract",
        "xcp_project",
        "source_map"
      ],
      "properties": {
        "inventory": { "$ref": "#/$defs/outcome" },
        "semantic_inventory": { "$ref": "#/$defs/outcome" },
        "creative_ir": { "$ref": "#/$defs/outcome" },
        "adaptation_plan": { "$ref": "#/$defs/outcome" },
        "fidelity_contract": { "$ref": "#/$defs/outcome" },
        "xcp_project": { "$ref": "#/$defs/outcome" },
        "source_map": { "$ref": "#/$defs/outcome" }
      }
    },
    "adaptation_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_level",
        "achieved_level",
        "source_scope",
        "semantic_record_count",
        "blocking_record_count",
        "reference_oracle",
        "human_playtest"
      ],
      "properties": {
        "target_level": { "const": "source_faithful" },
        "achieved_level": { "$ref": "#/$defs/fidelity_level" },
        "source_scope": { "const": "whole_project" },
        "semantic_record_count": { "$ref": "#/$defs/count" },
        "blocking_record_count": { "$ref": "#/$defs/count" },
        "reference_oracle": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "human_playtest": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        }
      }
    },
    "fidelity": {
      "type": "array",
      "minItems": 5,
      "maxItems": 13,
      "allOf": [
        { "contains": { "properties": { "dimension": { "const": "gameplay" } }, "required": [ "dimension" ] } },
        { "contains": { "properties": { "dimension": { "const": "input" } }, "required": [ "dimension" ] } },
        { "contains": { "properties": { "dimension": { "const": "ui" } }, "required": [ "dimension" ] } },
        { "contains": { "properties": { "dimension": { "const": "assets" } }, "required": [ "dimension" ] } },
        { "contains": { "properties": { "dimension": { "const": "state" } }, "required": [ "dimension" ] } }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "status",
          "coverage",
          "differences",
          "residual_work"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "gameplay",
              "input",
              "ui",
              "assets",
              "state",
              "audio",
              "rendering_2d",
              "behavior",
              "lifecycle",
              "other"
            ]
          },
          "status": {
            "enum": [
              "exact",
              "verified",
              "degraded",
              "blocked",
              "not_applicable"
            ]
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "total",
              "preserved_directly",
              "translated",
              "substituted",
              "degraded",
              "unsupported",
              "human_intervention_required"
            ],
            "properties": {
              "total": { "$ref": "#/$defs/count" },
              "preserved_directly": { "$ref": "#/$defs/count" },
              "translated": { "$ref": "#/$defs/count" },
              "substituted": { "$ref": "#/$defs/count" },
              "degraded": { "$ref": "#/$defs/count" },
              "unsupported": { "$ref": "#/$defs/count" },
              "human_intervention_required": { "$ref": "#/$defs/count" }
            }
          },
          "differences": { "$ref": "#/$defs/text_array" },
          "residual_work": { "$ref": "#/$defs/text_array" }
        }
      }
    },
    "corrections": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "error",
          "change",
          "retry_outcome",
          "evidence_refs"
        ],
        "properties": {
          "stage": { "enum": [ "conversion", "live" ] },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "code", "details" ],
            "properties": {
              "code": { "$ref": "#/$defs/contract_id" },
              "details": { "type": "object", "maxProperties": 128 }
            }
          },
          "change": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "retry_outcome": { "$ref": "#/$defs/outcome" },
          "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
        }
      }
    },
    "c5_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "install",
        "launch",
        "observe",
        "capture",
        "update",
        "rollback",
        "cleanup"
      ],
      "properties": {
        "authority": { "const": "C5_AGENT_NATIVE_CREATION_GATE" },
        "install": { "$ref": "#/$defs/lifecycle_step" },
        "launch": { "$ref": "#/$defs/lifecycle_step" },
        "observe": { "$ref": "#/$defs/lifecycle_step" },
        "capture": { "$ref": "#/$defs/lifecycle_step" },
        "update": { "$ref": "#/$defs/lifecycle_step" },
        "rollback": { "$ref": "#/$defs/lifecycle_step" },
        "cleanup": { "$ref": "#/$defs/lifecycle_step" }
      }
    },
    "differences": { "$ref": "#/$defs/text_array" },
    "residual_work": { "$ref": "#/$defs/text_array" },
    "worker_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_change_required",
        "general_capability_missing",
        "evidence_refs"
      ],
      "properties": {
        "native_change_required": { "type": "boolean" },
        "general_capability_missing": { "type": "boolean" },
        "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
      }
    },
    "decision": {
      "enum": [
        "ready_source_faithful",
        "not_ready",
        "human_intervention_required"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "contract_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_or_empty": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 400000
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    },
    "fidelity_level": {
      "enum": [
        "asset_preview",
        "vertical_slice",
        "behavioral_subset",
        "source_faithful"
      ]
    },
    "text_array": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "lifecycle_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "evidence_refs"
      ],
      "properties": {
        "outcome": { "$ref": "#/$defs/outcome" },
        "evidence_refs": { "$ref": "#/$defs/evidence_refs" }
      }
    }
  }
}
