{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcompute-probe.local/schemas/xcp-agent-project-intent-v1.schema.json",
  "title": "XCP agent project intent and acceptance contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "project_id",
    "summary",
    "experience_kind",
    "acceptance",
    "completion_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "xcp-agent-project-intent-v1"
    },
    "intent_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "experience_kind": {
      "enum": [
        "game",
        "application",
        "utility",
        "simulation",
        "interactive_scene",
        "educational",
        "experiment",
        "other"
      ]
    },
    "non_goals": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "interaction_sequences": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/interaction_sequence"
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "created_from_prompt",
            "external_source_adaptation"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "completion_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_blockers_must_pass",
        "minimum_live_captures",
        "structured_observation_required",
        "rollback_required",
        "cleanup_required"
      ],
      "properties": {
        "all_blockers_must_pass": {
          "const": true
        },
        "minimum_live_captures": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "structured_observation_required": {
          "const": true
        },
        "rollback_required": {
          "const": true
        },
        "cleanup_required": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "contract_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "severity",
        "observation_path",
        "operator",
        "expected",
        "correction_hint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "phase": {
          "enum": [
            "local",
            "live",
            "both"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "advisory"
          ]
        },
        "observation_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[a-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+|\\[[0-9]+\\])*$"
        },
        "operator": {
          "enum": [
            "equal",
            "not_equal",
            "greater",
            "greater_equal",
            "less",
            "less_equal",
            "contains",
            "matches",
            "exists"
          ]
        },
        "expected": {
          "$ref": "#/$defs/scalar"
        },
        "correction_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "interaction_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "steps",
        "assertion_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "repeat",
              "wait_ms"
            ],
            "properties": {
              "action": {
                "$ref": "#/$defs/contract_id"
              },
              "repeat": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "wait_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000
              }
            }
          }
        },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
