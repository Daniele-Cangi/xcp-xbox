{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcompute-probe.local/schemas/xcp-behavior-module-v1.schema.json",
  "title": "XCP deterministic behavior module v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "timers", "rules"],
  "properties": {
    "schema_version": {"const": "xcp-behavior-module-v1"},
    "state": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/state_entry"}
    },
    "timers": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/timer"}
    },
    "rules": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "contract_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
    },
    "scalar": {
      "anyOf": [
        {"type": "boolean"},
        {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        {"type": "number", "minimum": -1000000000, "maximum": 1000000000},
        {"type": "string", "maxLength": 4096}
      ]
    },
    "state_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "initial"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["boolean", "integer", "number", "string"]},
        "initial": {"$ref": "#/$defs/scalar"}
      }
    },
    "timer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interval_ms", "repeating", "event"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "interval_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "repeating": {"type": "boolean"},
        "event": {"$ref": "#/$defs/contract_id"}
      }
    },
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"$ref": "#/$defs/identifier"},
        "value": {"$ref": "#/$defs/scalar"}
      },
      "oneOf": [
        {"required": ["state"]},
        {"required": ["value"]}
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "operator", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/operand"},
        "operator": {"enum": ["equal", "not_equal", "less", "less_equal", "greater", "greater_equal"]},
        "right": {"$ref": "#/$defs/operand"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "state.set",
            "state.add",
            "state.toggle",
            "event.emit",
            "node.visibility",
            "node.translate2d",
            "node.translate3d",
            "ui.focus",
            "state.save",
            "state.load",
            "log.write"
          ]
        },
        "target": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/identifier"},
        "value": {"$ref": "#/$defs/scalar"},
        "event": {"$ref": "#/$defs/contract_id"},
        "vector": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}
        },
        "message": {"type": "string", "maxLength": 1024}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event", "conditions", "actions"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "event": {"$ref": "#/$defs/contract_id"},
        "conditions": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/condition"}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    }
  }
}
