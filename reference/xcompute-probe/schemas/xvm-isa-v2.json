{
  "schema_version": "xvm-isa-definition-0.1",
  "isa_version": "xvm-v2",
  "program_schema_version": "xvm-program-artifact-v2",
  "artifact_kind": "xvm-program-v2",
  "profile": "integer-deterministic-v2",
  "encoding": {
    "word_bits": 32,
    "instruction_words": 4,
    "register_count": 16,
    "typed_input_words": 11,
    "little_endian_memory": true
  },
  "limits": {
    "max_instructions": 4096,
    "max_loop_iterations": 65536,
    "max_loop_depth": 8,
    "max_conditional_depth": 8,
    "max_call_depth": 8,
    "max_functions": 64
  },
  "capabilities": [
    "artifact_input",
    "artifact_output",
    "control_output"
  ],
  "optional_capabilities": [
    "typed_memory_v1",
    "structured_control_v2",
    "structured_control_v2_phase_b",
    "spmd_lane_context_v1"
  ],
  "spmd_lane_context_v1": {
    "binding_schema": "xvm-spmd-lane-context-v1",
    "initial_registers": {
      "r12": "linear_lane_id",
      "r13": "lane_x",
      "r14": "lane_y",
      "r15": "lane_z"
    },
    "seed_is_immutable_execution_input": true,
    "registers_remain_private_per_lane": true,
    "isolated_opcode_added": false
  },
  "typed_memory_v1": {
    "element_types": ["u32"],
    "input_access": ["read"],
    "memory_access": ["read", "write", "read_write"],
    "output_access": ["write"],
    "max_views_per_space": 64,
    "view_ids": "globally_unique_safe_ids",
    "overlap": "rejected_within_each_address_space"
  },
  "structured_control_v2_phase_b": {
    "requires": ["structured_control_v2"],
    "ordered_comparisons": ["u32", "s32_twos_complement"],
    "select": "condition_register_is_also_destination",
    "loop_control": "innermost_verified_loop_only",
    "trap": "bounded_nonzero_code_with_forward_same_ownership_recovery",
    "trap_code_maximum": 65535,
    "snapshot_schema": "xvm-state-snapshot-v3",
    "trap_state_schema": "xvm-trap-state-v1"
  },
  "opcodes": [
    { "code": 0, "name": "halt", "operands": ["zero", "zero", "zero"] },
    { "code": 1, "name": "move_immediate", "operands": ["dst_reg", "u32", "reserved"] },
    { "code": 2, "name": "load_input_u32", "operands": ["dst_reg", "input_index", "reserved"] },
    { "code": 3, "name": "add_u32", "operands": ["dst_reg", "lhs_reg", "rhs_reg"] },
    { "code": 4, "name": "xor_u32", "operands": ["dst_reg", "lhs_reg", "rhs_reg"] },
    { "code": 5, "name": "multiply_u32", "operands": ["dst_reg", "lhs_reg", "rhs_reg"] },
    { "code": 6, "name": "rotate_left_u32", "operands": ["dst_reg", "src_reg", "count_0_31"] },
    { "code": 7, "name": "load_memory_u32", "operands": ["dst_reg", "byte_offset", "reserved"] },
    { "code": 8, "name": "store_memory_u32", "operands": ["src_reg", "byte_offset", "reserved"] },
    { "code": 9, "name": "equal_u32", "operands": ["dst_reg", "lhs_reg", "rhs_reg"] },
    { "code": 10, "name": "branch_if_zero", "operands": ["condition_reg", "forward_pc", "reserved"] },
    { "code": 11, "name": "loop_begin", "operands": ["iteration_count", "loop_end_pc", "reserved"] },
    { "code": 12, "name": "loop_end", "operands": ["loop_begin_pc", "reserved", "reserved"] },
    { "code": 13, "name": "output_u32", "operands": ["src_reg", "byte_offset", "reserved"] },
    { "code": 14, "name": "set_control", "operands": ["src_reg", "reserved", "reserved"] },
    { "code": 15, "name": "call", "operands": ["function_entry_pc", "zero", "zero"] },
    { "code": 16, "name": "return", "operands": ["zero", "zero", "zero"] },
    { "code": 17, "name": "if_zero", "operands": ["condition_reg", "else_or_end_if_pc", "end_if_pc"] },
    { "code": 18, "name": "else", "operands": ["end_if_pc", "zero", "zero"] },
    { "code": 19, "name": "end_if", "operands": ["zero", "zero", "zero"] },
    { "code": 20, "name": "less_than_u32", "operands": ["dst_reg", "lhs_reg", "rhs_reg"] },
    { "code": 21, "name": "less_than_s32", "operands": ["dst_reg", "lhs_reg", "rhs_reg"] },
    { "code": 22, "name": "select_u32", "operands": ["condition_and_dst_reg", "true_reg", "false_reg"] },
    { "code": 23, "name": "break_if_zero", "operands": ["condition_reg", "loop_begin_pc", "loop_end_pc"] },
    { "code": 24, "name": "continue_if_zero", "operands": ["condition_reg", "loop_begin_pc", "loop_end_pc"] },
    { "code": 25, "name": "trap_if_zero", "operands": ["condition_reg", "trap_code", "recovery_pc"] }
  ],
  "verification": {
    "entry_pc": 0,
    "main_terminator": "halt",
    "function_terminator": "return",
    "function_regions": "ordered_contiguous_cover_after_main",
    "call_targets": "declared_function_entries_only",
    "call_graph": "acyclic_reachable_and_within_declared_depth",
    "branches": "forward_within_current_region_and_not_into_loop_body",
    "loops": "structured_paired_and_bounded",
    "fuel": "charged_once_per_executed_instruction",
    "typed_memory_v1": "every_u32_input_memory_output_access_inside_declared_view_with_matching_access",
    "structured_control_v2": "verified_if_else_end_if_pairs_within_one_region_and_no_persistent_conditional_stack",
    "structured_control_v2_phase_b": "ordered_values_plus_innermost_loop_control_plus_same_ownership_recovered_traps"
  }
}
