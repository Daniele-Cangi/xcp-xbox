{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcompute-probe.local/schemas/xcp-creative-fidelity-evidence-v1.schema.json",
  "title": "XCP source adaptation reference and human fidelity evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "fidelity_contract_sha256",
    "xcp_project_sha256",
    "oracles",
    "human_playtest",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "xcp-creative-fidelity-evidence-v1"
    },
    "evidence_id": {
      "$ref": "#/$defs/identifier"
    },
    "fidelity_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "xcp_project_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "oracles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/oracle"
      }
    },
    "human_playtest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "evidence_refs",
        "acceptance"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs_or_empty"
        },
        "acceptance": {
          "const": "recognizable_and_playable_as_source_project"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not_run"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "decision": {
      "enum": [
        "pass",
        "fail"
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "evidence_refs_or_empty": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "required",
        "outcome",
        "evidence_refs",
        "comparison_contract"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "structural",
            "behavioral",
            "visual",
            "audio",
            "state"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "comparison_contract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
