{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcompute-probe.local/schemas/xcp-creative-evolution-overlay-v1.schema.json",
  "title": "XCP explicit project-evolution overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overlay_id",
    "project_id",
    "base",
    "purpose",
    "preservation_required",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": "xcp-creative-evolution-overlay-v1"
    },
    "overlay_id": {
      "$ref": "#/$defs/identifier"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "source_inventory_sha256",
        "creative_ir_sha256",
        "xcp_project_sha256",
        "project_tree_sha256"
      ],
      "properties": {
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "creative_ir_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "xcp_project_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "project_tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "preservation_required": {
      "const": true
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_json_path": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^(?:xcp-project\\.json|modules/[A-Za-z0-9._-]+\\.json)$"
    },
    "json_pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "document",
        "pointer",
        "op",
        "base_present",
        "base_value_sha256",
        "conflict_policy"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "document": {
          "$ref": "#/$defs/relative_json_path"
        },
        "pointer": {
          "$ref": "#/$defs/json_pointer"
        },
        "op": {
          "enum": [
            "add",
            "replace",
            "remove"
          ]
        },
        "base_present": {
          "type": "boolean"
        },
        "base_value_sha256": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "value": {},
        "conflict_policy": {
          "enum": [
            "require_human",
            "overlay_wins",
            "source_wins"
          ]
        },
        "choice_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "replace"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "base_present": {
                "const": false
              }
            },
            "required": [
              "base_present"
            ]
          },
          "then": {
            "properties": {
              "base_value_sha256": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "conflict_policy": {
                "enum": [
                  "overlay_wins",
                  "source_wins"
                ]
              }
            },
            "required": [
              "conflict_policy"
            ]
          },
          "then": {
            "required": [
              "choice_rationale"
            ]
          }
        }
      ]
    }
  }
}
