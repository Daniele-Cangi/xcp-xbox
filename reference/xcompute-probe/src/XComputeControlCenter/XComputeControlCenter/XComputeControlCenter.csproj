<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XComputeControlCenter</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <LangVersion>12.0</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Platforms>x64;x86;arm64</Platforms>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XComputeControlCenter.Core\XComputeControlCenter.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyWinUiCompiledResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XcpCompiledXaml Include="$(TargetDir)**\*.xbf" />
      <_XcpApplicationPri Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_XcpCompiledXaml)"
      DestinationFiles="@(_XcpCompiledXaml->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy
      SourceFiles="@(_XcpApplicationPri)"
      DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
