<Page
    x:Class="XComputeControlCenter.Views.EvidencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="0,18,0,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="STRUCTURED RESULTS · DISTINCT IDENTITIES" Style="{StaticResource StudioEyebrowStyle}" />
            <TextBlock Text="Understand what happened." Style="{StaticResource StudioPageTitleStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource StudioCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="LATEST OUTCOME" Style="{StaticResource StudioEyebrowStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                        Style="{StaticResource StudioBodyStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorCode, Mode=OneWay}"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Foreground="{StaticResource StudioWarningBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Correction, Mode=OneWay}"
                        Style="{StaticResource StudioBodyStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StudioCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="CURRENT SURFACE" Style="{StaticResource StudioEyebrowStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedOperations, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding}"
                                    Margin="0,3"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource StudioHeroCardStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="LAST STRUCTURED RESULT / RECEIPT" Style="{StaticResource StudioEyebrowStyle}" />
                <TextBox
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.StructuredResult, Mode=OneWay}"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="11.5"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Page>
