<Page
    x:Class="XComputeControlCenter.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:XComputeControlCenter.Core">
    <Grid Padding="0,18,0,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="ONE FILE · TWO EDITING MODES" Style="{StaticResource StudioEyebrowStyle}" />
            <TextBlock Text="Shape the project." Style="{StaticResource StudioPageTitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource StudioCardStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="RECENT PROJECT LIBRARY" Style="{StaticResource StudioEyebrowStyle}" />
                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecentProjectItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedRecentProject, Mode=TwoWay}"
                        MaxHeight="150"
                        SelectionMode="Single"
                        AutomationProperties.Name="Recent XCP projects">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:StudioRecentProjectEntry">
                                <Grid ColumnSpacing="14" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource StudioBodyStyle}" />
                                        <TextBlock Text="{x:Bind LocationLabel}" Style="{StaticResource StudioMonoStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Provenance}" Style="{StaticResource StudioBodyStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind StatusLabel}" Style="{StaticResource StudioEyebrowStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Refresh" Click="RefreshLibrary_Click" />
                    <Button Content="Open selected" Click="OpenRecent_Click" />
                    <Button Content="Relink moved" Click="RelinkRecent_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource StudioCardStyle}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="Project directory"
                    Text="{x:Bind ViewModel.ProjectDirectory, Mode=TwoWay}"
                    AutomationProperties.Name="XCP project directory" />
                <Button Grid.Column="1" Content="Browse" Click="BrowseProject_Click" VerticalAlignment="Bottom" />
                <Button Grid.Column="2" Content="Open" Click="OpenProject_Click" VerticalAlignment="Bottom" />
                <Button Grid.Column="3" Content="Play on Xbox" Click="PlayOnXbox_Click" VerticalAlignment="Bottom" />
                <Button Grid.Column="4" Content="Details" Click="Evidence_Click" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource StudioInnerPanelStyle}">
            <StackPanel Spacing="5">
                <TextBlock Text="CURRENT STEP" Style="{StaticResource StudioEyebrowStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Style="{StaticResource StudioBodyStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.ErrorCode, Mode=OneWay}" Style="{StaticResource StudioMonoStyle}" Foreground="{StaticResource StudioWarningBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Correction, Mode=OneWay}" Style="{StaticResource StudioBodyStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="GuidedModeButton"
                    Content="Guided"
                    Background="{StaticResource StudioAccentDimBrush}"
                    BorderBrush="{StaticResource StudioAccentBrush}"
                    Click="GuidedMode_Click"
                    AutomationProperties.Name="Show guided project editor" />
                <Button
                    x:Name="ExpertModeButton"
                    Content="Expert source"
                    Click="ExpertMode_Click"
                    AutomationProperties.Name="Show expert source editor" />
                <TextBlock
                    Text="Both modes edit the same observed revision."
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource StudioBodyStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource StudioHeroCardStyle}">
                <Grid>
                    <ScrollViewer
                        x:Name="GuidedEditor"
                        HorizontalScrollMode="Disabled">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="Title"
                                    Text="{x:Bind ViewModel.ProjectTitle, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Column="1"
                                    Header="Version"
                                    Text="{x:Bind ViewModel.ProjectVersion, Mode=TwoWay}" />
                            </Grid>
                            <TextBox
                                Header="Description"
                                Text="{x:Bind ViewModel.ProjectDescription, Mode=TwoWay}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="110" />
                            <TextBox
                                Header="Local bundle output"
                                Text="{x:Bind ViewModel.BundleDirectory, Mode=TwoWay}" />
                            <Button
                                Content="Save guided changes"
                                HorizontalAlignment="Left"
                                Click="SaveGuided_Click" />
                            <Border Style="{StaticResource StudioInnerPanelStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="OBSERVED PROJECT SHA-256" Style="{StaticResource StudioEyebrowStyle}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ProjectSha256, Mode=OneWay}"
                                        Style="{StaticResource StudioMonoStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid
                        x:Name="ExpertEditor"
                        Visibility="Collapsed"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            Header="xcp-project.json"
                            Text="{x:Bind ViewModel.ProjectSource, Mode=TwoWay}"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Button
                            Grid.Row="1"
                            Content="Save exact source"
                            HorizontalAlignment="Left"
                            Click="SaveSource_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
