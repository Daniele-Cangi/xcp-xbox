<Application
    x:Class="XComputeControlCenter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The historical WinUI draft established the matte console palette
                and compact evidence typography. These tokens are the reusable
                visual layer only; current C5/C6/C7 contracts remain authoritative.
            -->
            <LinearGradientBrush
                x:Key="StudioBackgroundBrush"
                StartPoint="0,0"
                EndPoint="0.55,1">
                <GradientStop Color="#070908" Offset="0" />
                <GradientStop Color="#0B0E0C" Offset="0.55" />
                <GradientStop Color="#050706" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="StudioPaneBrush" Color="#030504" />
            <SolidColorBrush x:Key="StudioSurfaceBrush" Color="#111512" />
            <SolidColorBrush x:Key="StudioRaisedBrush" Color="#171C18" />
            <SolidColorBrush x:Key="StudioSunkenBrush" Color="#090C0A" />
            <SolidColorBrush x:Key="StudioBorderBrush" Color="#293029" />
            <SolidColorBrush x:Key="StudioStrongBorderBrush" Color="#3A453C" />
            <SolidColorBrush x:Key="StudioAccentBrush" Color="#39D353" />
            <SolidColorBrush x:Key="StudioAccentDimBrush" Color="#16371D" />
            <SolidColorBrush x:Key="StudioSecondaryTextBrush" Color="#A4ADA6" />
            <SolidColorBrush x:Key="StudioMutedTextBrush" Color="#717C73" />
            <SolidColorBrush x:Key="StudioWarningBrush" Color="#F0B85A" />
            <SolidColorBrush x:Key="StudioDangerBrush" Color="#F06C65" />

            <SolidColorBrush
                x:Key="NavigationViewDefaultPaneBackground"
                Color="#030504" />
            <SolidColorBrush
                x:Key="NavigationViewExpandedPaneBackground"
                Color="#030504" />
            <SolidColorBrush
                x:Key="NavigationViewContentBackground"
                Color="Transparent" />
            <SolidColorBrush
                x:Key="NavigationViewSelectionIndicatorForeground"
                Color="#39D353" />
            <Color x:Key="SystemAccentColor">#39D353</Color>
            <Color x:Key="SystemAccentColorLight1">#55E06A</Color>
            <Color x:Key="SystemAccentColorLight2">#73E884</Color>
            <Color x:Key="SystemAccentColorDark1">#2DB945</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#39D353" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#041108" />

            <Style x:Key="StudioPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-12" />
            </Style>

            <Style x:Key="StudioSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="StudioEyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="105" />
                <Setter Property="Foreground" Value="{StaticResource StudioMutedTextBrush}" />
            </Style>

            <Style x:Key="StudioBodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource StudioSecondaryTextBrush}" />
            </Style>

            <Style x:Key="StudioMonoStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="StudioCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="StudioHeroCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioStrongBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24" />
            </Style>

            <Style x:Key="StudioInnerPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioSunkenBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="StudioPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource StudioAccentDimBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="9,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
