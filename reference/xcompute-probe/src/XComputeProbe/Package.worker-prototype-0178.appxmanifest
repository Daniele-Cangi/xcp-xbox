<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap mp">
  <!-- Exact non-promoted G2P2H generic UI-safe diagnostic-overlay candidate. -->
  <Identity Name="XComputeProbe.WorkerPrototype" Publisher="CN=LocalDev" Version="0.1.178.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="d1e0de7c-d7b1-4e6b-89f5-0acb0829f7db" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>XCP WORKER</DisplayName>
    <PublisherDisplayName>LocalDev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="XComputeProbe.CpuCapsule.Framework" Publisher="CN=LocalDev" MinVersion="1.3.0.0" MaxMajorVersionTested="1" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="XComputeProbe.App">
      <uap:VisualElements
        DisplayName="XCP WORKER"
        Description="LocalFolder search and patch worker prototype"
        BackgroundColor="#0B1220"
        Square150x150Logo="Assets\Logo.png"
        Square44x44Logo="Assets\SmallLogo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B1220" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.appService" EntryPoint="XComputeTopologyBroker.BrokerTask" ResourceGroup="xcp.process.topology.probe.v1">
          <uap:AppService Name="xcp.process.topology.probe.v1" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
